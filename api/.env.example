# =================================================================
# REST API Microservice Environment Variables Example
# Copy this file to 'api/.env' for local development.
# =================================================================

PORT=3000
DATABASE_URL="mysql://resume_user:your_db_password_here@localhost:3307/resume_parser_db"
REDIS_HOST=localhost
REDIS_PORT=6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=resumes
JWT_SECRET=your_super_secret_jwt_key_here
CORS_ORIGIN=http://localhost,http://localhost:8080,http://localhost:4200

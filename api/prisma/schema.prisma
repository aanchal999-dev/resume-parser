datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum ProcessingStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resumes  Resume[]
  jobRoles JobRole[]

  @@map("users")
}

model Resume {
  id               String           @id @default(uuid())
  recruiterId      String
  originalFilename String
  minioFileKey     String
  candidateName    String?
  email            String?
  phone            String?
  location         String?
  skills           Json?
  experienceYears  Float?
  education        String?
  rawText          String?          @db.LongText
  status           ProcessingStatus @default(QUEUED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  recruiter User @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

model JobRole {
  id             String   @id @default(uuid())
  recruiterId    String?
  title          String
  requiredSkills Json
  minExperience  Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  recruiter User? @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@map("job_roles")
}

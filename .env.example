# =================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE: Resume Parser & Insight Dashboard
# Copy this file to '.env' and adjust values for your environment.
# =================================================================

# Database Configuration (MySQL)
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=resume_parser_db
MYSQL_USER=resume_user
MYSQL_PASSWORD=your_db_password_here
MYSQL_HOST=localhost
MYSQL_CONTAINER_PORT=3306
MYSQL_HOST_PORT=3307

# Redis Configuration (Queue & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO Configuration (Object File Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=resumes

# Backend & Gateway Application Configuration
PORT=3000
GATEWAY_PORT=8080
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_here
CORS_ORIGIN=http://localhost,http://localhost:8080,http://localhost:4200
